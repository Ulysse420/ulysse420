{
  "name": "haven",
  "version": "1.0.0",
  "description": "A privacy-first social platform — no ads, no tracking, no data extraction.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && node index.js",
    "client": "cd client && npx vite --host",
    "build": "cd client && npx vite build",
    "start": "cd server && NODE_ENV=production node index.js",
    "setup": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": ["social", "privacy", "decentralized"],
  "license": "AGPL-3.0",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
